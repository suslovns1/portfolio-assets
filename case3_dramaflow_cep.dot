
digraph G {
    graph [bgcolor="#0B0F19", fontname="Helvetica, Arial, sans-serif", fontsize=12, pad="0.4", rankdir="LR", nodesep=0.5, ranksep=0.6, splines="ortho"];
    node [fontname="Helvetica, Arial, sans-serif", shape=box, style="filled,rounded", fontsize=11, fontcolor="#F8FAFC", fillcolor="#131B2E", color="#2563EB", penwidth=1.5, margin="0.2,0.15"];
    edge [fontname="Helvetica, Arial, sans-serif", fontsize=9, fontcolor="#94A3B8", color="#38BDF8", penwidth=1.5, arrowhead="normal", arrowsize=0.8];

    // Ingest
    subgraph cluster_0 {
        label = "1. Creative Grammar Ingest";
        fontcolor = "#38BDF8";
        fontsize = 13;
        color = "#334155";
        style = "rounded,dashed";
        bgcolor = "#0F172A";
        margin = 15;

        comp_name [label="Structured Comp Name\n(e.g. 0012_T1_H1-E1736-M12)", shape=oval, fillcolor="#1E293B", color="#3B82F6"];
        parser [label="CEP Extension Parser\n- Extracts Subscene, Hook, Element\n- Maps Text ID & Audio Variant"];
        healer [label="Media Auto-Healing\n- Magic-byte format detection\n- Normalizes .badext / missing"];

        comp_name -> parser -> healer;
    }

    // AE Modular Assembly
    subgraph cluster_1 {
        label = "2. Modular Layer Compositor & AI Processing";
        fontcolor = "#38BDF8";
        fontsize = 13;
        color = "#334155";
        style = "rounded,dashed";
        bgcolor = "#0F172A";
        margin = 15;

        subscene_layer [label="Subscene Video Cuts\n(Frame-accurate sync)"];
        hook_layer [label="Dynamic Hook Asset\n(H-id normalization)"];
        element_key [label="Auto Linear Color Key\n(12-45% neutral/green keying)"];
        text_db [label="Airtable DB Presync\n(110px safe margin + PNG emojis)"];
        local_uvr [label="Local UVR AI (MDX23C)\n(Generates [VOCALS]/[MUSIC] stems)"];
        sub_style [label="Kinetic Subtitle Styles\n(Word-level animation engine)"];

        healer -> subscene_layer;
        healer -> hook_layer;
        healer -> element_key;
        healer -> text_db;
        healer -> local_uvr;
        healer -> sub_style;
    }

    // Render & Output
    subgraph cluster_2 {
        label = "3. ExtendScript Execution & Variations";
        fontcolor = "#38BDF8";
        fontsize = 13;
        color = "#334155";
        style = "rounded,dashed";
        bgcolor = "#0F172A";
        margin = 15;

        extendscript_engine [label="ExtendScript Render Pipeline\n- Inline H.264 & First-Frame PNG\n- Session log & preflight checks"];
        variations_out [label="20+ Scaled Variations in 15s\n(80x Turnaround Acceleration)", shape=oval, fillcolor="#0F2E1E", color="#10B981"];

        subscene_layer -> extendscript_engine;
        hook_layer -> extendscript_engine;
        element_key -> extendscript_engine;
        text_db -> extendscript_engine;
        local_uvr -> extendscript_engine;
        sub_style -> extendscript_engine;

        extendscript_engine -> variations_out;
    }
}
