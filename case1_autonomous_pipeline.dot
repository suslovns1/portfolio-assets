
digraph G {
    graph [bgcolor="#0B0F19", fontname="Helvetica, Arial, sans-serif", fontsize=12, pad="0.4", rankdir="LR", nodesep=0.5, ranksep=0.7, splines="ortho"];
    node [fontname="Helvetica, Arial, sans-serif", shape=box, style="filled,rounded", fontsize=11, fontcolor="#F8FAFC", fillcolor="#131B2E", color="#2563EB", penwidth=1.5, margin="0.2,0.15"];
    edge [fontname="Helvetica, Arial, sans-serif", fontsize=9, fontcolor="#94A3B8", color="#38BDF8", penwidth=1.5, arrowhead="normal", arrowsize=0.8];

    // Subgraph 1: Strategy
    subgraph cluster_0 {
        label = "1. Ingest & Creative Strategy";
        fontcolor = "#38BDF8";
        fontsize = 13;
        color = "#334155";
        style = "rounded,dashed";
        bgcolor = "#0F172A";
        margin = 15;

        start [label="Campaign Brief Ingest\n(Airtable / Jira Tasks)", shape=oval, fillcolor="#1E293B", color="#3B82F6"];
        claude [label="Dynamic Claude Orchestrator\n- Prompt Strategy & Script\n- Storyboard Manifest Builder"];
        manifest [label="Validated Storyboard\nManifest (JSON)", shape=note, fillcolor="#1E293B", color="#64748B"];
        
        start -> claude -> manifest;
    }

    // Subgraph 2: Multimodal AI
    subgraph cluster_1 {
        label = "2. Parallel Multimodal AI Generation";
        fontcolor = "#38BDF8";
        fontsize = 13;
        color = "#334155";
        style = "rounded,dashed";
        bgcolor = "#0F172A";
        margin = 15;

        gen_video [label="Video Gen Engine\n(Higgsfield API / CLI)"];
        gen_audio [label="Voiceover Synthesis\n(ElevenLabs API)"];
        gen_music [label="Adaptive Soundtrack\n(Suno API / CLI)"];
        
        manifest -> gen_video;
        manifest -> gen_audio;
        manifest -> gen_music;
    }

    // Subgraph 3: Headless Assembly
    subgraph cluster_2 {
        label = "3. Headless AE Server & Validation";
        fontcolor = "#38BDF8";
        fontsize = 13;
        color = "#334155";
        style = "rounded,dashed";
        bgcolor = "#0F172A";
        margin = 15;

        ae_engine [label="Headless AE Render Server\n- ExtendScript Comp Builder\n- Dynamic Audio/Video Sync"];
        side_by_side [label="Side-by-Side Review UI\n(Brief vs Rendered Video)", shape=diamond, fillcolor="#1E293B", color="#F59E0B"];
        out_aep [label="Open Native .aep Project\n(Modular Layers & Presets)", shape=box, fillcolor="#0F2E1E", color="#10B981"];
        out_ready [label="Approved Video Creatives\n(2,000+ Scaled Concepts)", shape=oval, fillcolor="#0F2E1E", color="#10B981"];

        gen_video -> ae_engine;
        gen_audio -> ae_engine;
        gen_music -> ae_engine;

        ae_engine -> side_by_side;
        ae_engine -> out_aep [label="Zero-Blackbox"];
        side_by_side -> out_ready [label="1-Click Approve"];
        side_by_side -> claude [label="Revision Feedback", style=dashed, color="#F59E0B"];
    }
}
